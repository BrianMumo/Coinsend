# Database
DATABASE_URL="postgresql://user:password@localhost:5432/coinsend?schema=public"

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ADMIN_SECRET="your-super-secret-admin-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_ADMIN_EXPIRES_IN="24h"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Admin Seed Credentials (used by prisma db seed)
ADMIN_EMAIL="admin@coinsend.com"
ADMIN_PASSWORD="changeme-on-first-login"

# Telegram Bot (for monitoring notifications)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
