generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum OrderType {
  CRYPTO_TO_KES
  KES_TO_CRYPTO
  CROSS_BORDER
  OTC
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum CryptoCurrency {
  USDT
  USDC
  BTC
  ETH
}

enum CryptoNetwork {
  TRON
  ETHEREUM
  BSC
  POLYGON
  BITCOIN
}

enum MpesaTransactionType {
  C2B_STK_PUSH
  C2B_PAYBILL
  B2C_PAYMENT
  BALANCE_QUERY
  REVERSAL
}

enum MpesaTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

enum BalanceTransactionType {
  DEPOSIT           // M-Pesa deposit to KES balance (deprecated)
  WITHDRAWAL        // Withdraw KES balance to M-Pesa (deprecated)
  ORDER_PAYMENT     // Used balance to pay for order (deprecated)
  ORDER_REFUND      // Refund from cancelled order (deprecated)
  ADJUSTMENT        // Admin adjustment
  USDT_DEPOSIT      // USDT deposit to balance
  USDT_WITHDRAWAL   // Withdraw USDT to external wallet
  KES_WITHDRAWAL    // Withdraw as KES to M-Pesa (converts USDT at rate)
}

enum BalanceTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// ============ MODELS ============

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  phone              String?    @unique
  passwordHash       String
  firstName          String?
  lastName           String?
  country            String     @default("KE")
  kycStatus          KycStatus  @default(UNVERIFIED)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  depositAddress     String?    @unique  // Personal TRC-20 deposit address (HD wallet)
  walletIndex        Int?       @unique  // HD wallet derivation index (m/44'/195'/0'/0/{index})

  orders              Order[]
  balance             UserBalance?
  pendingUsdtDeposits PendingUsdtDeposit[]

  @@index([email])
  @@index([phone])
  @@index([kycStatus])
  @@index([depositAddress])
}

model Admin {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          AdminRole  @default(ADMIN)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  processedOrders     Order[]              @relation("ProcessedByAdmin")
  mpesaTransactions   MpesaTransaction[]

  @@index([email])
  @@index([role])
}

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  userId              String
  orderType           OrderType
  status              OrderStatus   @default(PENDING)

  // Currencies
  sourceCurrency      String
  destinationCurrency String

  // Amounts
  sourceAmount        Decimal       @db.Decimal(18, 8)
  destinationAmount   Decimal       @db.Decimal(18, 8)
  exchangeRate        Decimal       @db.Decimal(18, 8)
  fee                 Decimal       @default(0) @db.Decimal(18, 8)

  // Payment details (user -> Coinsend)
  paymentMethod       String?
  paymentReference    String?
  paymentProofUrl     String?

  // Payout details (Coinsend -> user)
  payoutMethod        String?
  payoutReference     String?
  payoutDestination   String?

  // Cross-border specific
  recipientName       String?
  recipientPhone      String?
  recipientBank       String?
  recipientAccount    String?

  // Processing
  processedById       String?
  processingNotes     String?

  // Timestamps
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  paidAt              DateTime?
  completedAt         DateTime?
  expiresAt           DateTime?

  // Relations
  user                User          @relation(fields: [userId], references: [id])
  processedBy         Admin?        @relation("ProcessedByAdmin", fields: [processedById], references: [id])
  mpesaTransactions   MpesaTransaction[]
  balanceTransactions BalanceTransaction[]
  cryptoTransactions  CryptoTransaction[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
}

model Wallet {
  id            String          @id @default(uuid())
  currency      CryptoCurrency
  network       CryptoNetwork
  address       String          @unique
  label         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([currency])
  @@index([network])
  @@index([isActive])
}

model LiquidityBalance {
  id            String     @id @default(uuid())
  currency      String     @unique
  balance       Decimal    @db.Decimal(18, 8)
  lastUpdated   DateTime   @default(now())
  updatedBy     String?
  notes         String?

  @@index([currency])
}

model ExchangeRate {
  id            String     @id @default(uuid())
  pair          String     @unique
  buyRate       Decimal    @db.Decimal(18, 8)
  sellRate      Decimal    @db.Decimal(18, 8)
  midRate       Decimal    @db.Decimal(18, 8)
  spread        Decimal    @db.Decimal(5, 4)
  minAmount     Decimal    @default(10) @db.Decimal(18, 8)
  maxAmount     Decimal    @default(100000) @db.Decimal(18, 8)
  isActive      Boolean    @default(true)
  lastUpdated   DateTime   @default(now())
  updatedBy     String?

  @@index([pair])
  @@index([isActive])
}

model AuditLog {
  id            String     @id @default(uuid())
  userId        String?
  adminId       String?
  action        String
  entityType    String?
  entityId      String?
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model MpesaTransaction {
  id                        String                  @id @default(uuid())
  transactionType           MpesaTransactionType
  status                    MpesaTransactionStatus  @default(PENDING)
  originatorConversationId  String?                 @unique
  conversationId            String?
  commandId                 String?
  amount                    Decimal                 @db.Decimal(18, 2)
  phoneNumber               String?
  shortcode                 String?
  mpesaReceiptNumber        String?
  resultCode                Int?
  resultDesc                String?
  receiverPartyPublicName   String?
  b2cWorkingBalance         Decimal?                @db.Decimal(18, 2)
  b2cUtilityBalance         Decimal?                @db.Decimal(18, 2)
  orderId                   String?
  initiatedById             String?
  notes                     String?
  rawRequest                Json?
  rawResponse               Json?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  completedAt               DateTime?

  // For reversals - links to the original transaction being reversed
  reversedTransactionId     String?
  isReversed                Boolean                 @default(false)

  order                     Order?                  @relation(fields: [orderId], references: [id])
  initiatedBy               Admin?                  @relation(fields: [initiatedById], references: [id])

  @@index([transactionType])
  @@index([status])
  @@index([phoneNumber])
  @@index([mpesaReceiptNumber])
  @@index([createdAt])
  @@index([reversedTransactionId])
}

model UserBalance {
  id            String     @id @default(uuid())
  userId        String     @unique
  balance       Decimal    @default(0) @db.Decimal(18, 2)  // KES balance
  usdtBalance   Decimal    @default(0) @db.Decimal(18, 6)  // USDT balance (6 decimals)
  currency      String     @default("KES")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  transactions  BalanceTransaction[]

  @@index([userId])
}

model BalanceTransaction {
  id              String                    @id @default(uuid())
  userBalanceId   String
  type            BalanceTransactionType
  status          BalanceTransactionStatus  @default(PENDING)
  currency        String                    @default("KES")  // KES or USDT
  amount          Decimal                   @db.Decimal(18, 6)
  usdtAmount      Decimal?                  @db.Decimal(18, 6)  // Original USDT amount for USDT transactions
  balanceBefore   Decimal                   @db.Decimal(18, 6)
  balanceAfter    Decimal                   @db.Decimal(18, 6)
  reference       String?                   // M-Pesa receipt, tx hash, order number
  orderId         String?
  description     String?
  phoneNumber     String?                   // For KES deposits/withdrawals
  walletAddress   String?                   // For USDT withdrawals
  txHash          String?                   // For USDT transactions
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  completedAt     DateTime?

  userBalance     UserBalance               @relation(fields: [userBalanceId], references: [id])
  order           Order?                    @relation(fields: [orderId], references: [id])

  @@index([userBalanceId])
  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([reference])
  @@index([currency])
  @@index([createdAt])
}

// ============ CRYPTO TRANSACTIONS ============

enum CryptoTransactionType {
  DEPOSIT       // Incoming USDT from user
  WITHDRAWAL    // Outgoing USDT to user
}

enum CryptoTransactionStatus {
  PENDING       // Waiting for confirmations
  CONFIRMED     // Confirmed on blockchain
  COMPLETED     // Processed by system
  FAILED        // Failed transaction
}

model CryptoTransaction {
  id              String                    @id @default(uuid())
  type            CryptoTransactionType
  status          CryptoTransactionStatus   @default(PENDING)
  currency        CryptoCurrency            @default(USDT)
  network         CryptoNetwork             @default(TRON)

  // Transaction details
  txHash          String                    @unique
  fromAddress     String
  toAddress       String
  amount          Decimal                   @db.Decimal(18, 6)
  fee             Decimal?                  @db.Decimal(18, 6)

  // Block info
  blockNumber     BigInt?
  confirmations   Int                       @default(0)

  // Link to order (optional)
  orderId         String?

  // Timestamps
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  confirmedAt     DateTime?

  // Raw data
  rawData         Json?
  notes           String?

  order           Order?                    @relation(fields: [orderId], references: [id])

  @@index([type])
  @@index([status])
  @@index([txHash])
  @@index([fromAddress])
  @@index([toAddress])
  @@index([orderId])
  @@index([createdAt])
}

// System config for storing things like last processed block
model SystemConfig {
  key             String                    @id
  value           String
  updatedAt       DateTime                  @updatedAt
}

// ============ PENDING USDT DEPOSITS ============
// Tracks user-initiated deposit intents for amount-based matching

enum PendingDepositStatus {
  PENDING       // Waiting for deposit
  MATCHED       // Deposit detected and matched
  EXPIRED       // No deposit received within window
  CANCELLED     // User cancelled
}

model PendingUsdtDeposit {
  id              String                    @id @default(uuid())
  userId          String
  expectedAmount  Decimal                   @db.Decimal(18, 6)  // USDT amount user said they're sending
  kesAmount       Decimal?                  @db.Decimal(18, 2)  // KES to credit (calculated at current rate)
  exchangeRate    Decimal?                  @db.Decimal(18, 8)  // Rate at time of intent
  status          PendingDepositStatus      @default(PENDING)

  // Matching info
  matchedTxHash   String?                   // TX hash when matched
  matchedAmount   Decimal?                  @db.Decimal(18, 6)  // Actual amount received
  matchedAt       DateTime?

  // Timestamps
  createdAt       DateTime                  @default(now())
  expiresAt       DateTime                  // Intent expires after 1 hour

  user            User                      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expectedAmount])
  @@index([expiresAt])
}
