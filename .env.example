# ===========================================
# COINSEND ENVIRONMENT VARIABLES
# ===========================================

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/coinsend

# JWT Authentication
JWT_SECRET=generate-a-strong-secret-key-at-least-32-chars
JWT_ADMIN_SECRET=generate-a-different-strong-secret-for-admin
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# Server Configuration
PORT=4000
NODE_ENV=production

# Frontend URL (your Vercel deployment URL)
# For multiple URLs, use comma-separated values
FRONTEND_URL=https://your-app.vercel.app

# Admin Seed Credentials (used by prisma db seed)
ADMIN_EMAIL=admin@coinsend.com
ADMIN_PASSWORD=changeme-on-first-login

# ===========================================
# FRONTEND ENVIRONMENT (.env in frontend/)
# ===========================================
# VITE_API_URL=https://your-backend.railway.app/api
